pipeline{
    agent {
        label 'cimachine'
    }

    stages {
        stage("AppCode Checkout"){
            steps{
              git branch:'java', url:'https://github.com/prateekkumawat/jenkins5pmtest.git' 
            }
        }
        stage("Build Image"){
            steps{
                sh " docker build -t javaapp:latest . "
            }
        }
        stage("Spin Container"){
            steps{
                sh " docker-compose up -d "
            }
        }
    }
}