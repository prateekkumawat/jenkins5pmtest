pipeline {
    agent {
        label 'cimachine'
    }
    options {
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '3'))
    }

    environment {
        SSHOME = tool 'sonar-scanner'
        DOKCER_REGISTRY_CREDS = credentials('docker-creds')
    }

    stages {
        stage("App code Checkout"){
            steps {
                git branch: 'kubernetes', url:'https://github.com/prateekkumawat/jenkins5pmtest.git'
            }
        }

        stage("Sonar Analysis"){
            steps{
              dir('src/') {
                withSonarQubeEnv('sonar-server') {
                    sh ''' $SSHOME/bin/sonar-scanner \
                    -Dsonar.projectKey=villa-agency-project-ci \
                    -Dsonar.projectName=villa-agency-project-ci '''  
                }
              }
            }
        }

        stage('QualityGate') {
            steps {
                script {
                    dir('src/') {
                        waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token' 
                    }
                }
            }
        }
        stage("Scan CODEFS"){
            steps{
                sh "trivy fs src/ >> /tmp/trivyscanfs.txt "
            }
        }
        stage("build Image"){
            steps{
                sh "docker build -t villaimage:${BUILD_NUMBER} ."
            }
        }

        stage("Scan Image Trivy"){
            steps{
                sh "trivy image villaimage:${BUILD_NUMBER} >> /tmp/trivyscan.txt "
            }
        }

        stage("Image Push to Registry"){
            steps {
                sh "docker tag -t villaimage:${BUILD_NUMBER} prateekkumawat/villaimage:${BUILD_NUMBER} "
                sh " docker login -u $DOKCER_REGISTRY_CREDS_USR -p $DOKCER_REGISTRY_CREDS_PSW "
                sh " docker push prateekkumawat/villaimage:${BUILD_NUMBER} "
                sh " docker image rm -f prateekkumawat/villaimage:${BUILD_NUMBER} "
            }
        }
    }
}