pipeline {
    agent {
        label 'cimachine'
    }
    options {
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '3'))
    }

    environment {
        SSHOME = tool 'sonar-scanner'
    }

    stages {
        stage("App code Checkout"){
            steps {
                git branch: 'sonarintegrated', url:'https://github.com/prateekkumawat/jenkins5pmtest.git'
            }
        }

        stage("Sonar Analysis"){
            steps{
              dir('src/') {
                withSonarQubeEnv('sonar-server') {
                    sh ''' $SSHOME/bin/sonar-scanner \
                    -Dsonar.projectKey=sonar-jenkins-integrated \
                    -Dsonar.python.version=3.11 \
                    -Dsonar.projectName=sonar-jenkins-integrated '''  
                }
              }
            }
        }

        stage('QualityGate') {
            steps {
                script {
                    dir('src/') {
                        waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token' 
                    }
                }
            }
        }
        stage("Scan CODEFS"){
            steps{
                sh "trivy fs src/ >> /tmp/trivyscanfs.txt "
            }
        }
        stage("build Image"){
            steps{
                sh "docker build -t webapp:v1 ."
            }
        }

        stage("Scan Image Trivy"){
            steps{
                sh "trivy image webapp:v1 >> /tmp/trivyscan.txt "
            }
        }
    }
}